{
  "name": "genclass",
  "version": "0.2.2",
  "description": "GenClass CLI: one command that signs you in, adds GenClass to your app, connects the GitHub App and your coding agent, shows your app in the terminal and tells you what it is missing.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genclass-dev/GenClass.git",
    "directory": "packages/cli"
  },
  "homepage": "https://genclass.dev/docs/cli",
  "bugs": {
    "url": "https://github.com/genclass-dev/GenClass/issues"
  },
  "keywords": [
    "genclass",
    "cli",
    "race-condition",
    "stale-response",
    "duplicate-request",
    "seo",
    "launch-checklist",
    "playwright",
    "github-app"
  ],
  "bin": {
    "genclass": "./bin/genclass.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
