--- /dev/null
+++ b/client/cypress/tests/components/widgets/BookDetailsEdit.cy.js
@@ -0,0 +1,76 @@
+import BookDetailsEdit from '@/components/widgets/BookDetailsEdit.vue'
+import TextInputWithLabel from '@/components/ui/TextInputWithLabel.vue'
+import TextInput from '@/components/ui/TextInput.vue'
+
+describe('BookDetailsEdit', () => {
+  const libraryItem = {
+    id: 'li_1',
+    mediaType: 'book',
+    media: {
+      metadata: {
+        title: 'Original Title',
+        subtitle: null,
+        description: null,
+        authors: [],
+        narrators: [],
+        genres: [],
+        series: [],
+        publishedYear: '2001',
+        publisher: 'Original Publisher',
+        language: null,
+        isbn: null,
+        asin: null,
+        explicit: false,
+        abridged: false
+      },
+      tags: []
+    }
+  }
+
+  const withMetadata = (item, metadata) => ({ ...item, media: { ...item.media, metadata: { ...item.media.metadata, ...metadata } } })
+
+  const mountOptions = {
+    propsData: { libraryItem },
+    mocks: {
+      $store: {
+        state: {
+          libraries: { filterData: {} }
+        }
+      }
+    },
+    stubs: {
+      'ui-text-input-with-label': TextInputWithLabel,
+      'ui-text-input': TextInput,
+      'ui-multi-select-query-input': true,
+      'ui-multi-select': true,
+      'ui-rich-text-editor': true,
+      'ui-checkbox': true,
+      'widgets-series-input-widget': true
+    }
+  }
+
+  it('keeps unsaved edits when the same item is updated', () => {
+    cy.mount(BookDetailsEdit, mountOptions).then(({ wrapper }) => {
+      cy.get('input[placeholder="Title"]').should('have.value', 'Original Title').clear().type('Edited Title')
+
+      // e.g. the item_updated socket event after a match or a scan
+      cy.then(() => wrapper.setProps({ libraryItem: withMetadata(libraryItem, { publisher: 'New Publisher' }) }))
+
+      cy.get('input[placeholder="Title"]').should('have.value', 'Edited Title')
+      cy.get('input[placeholder="Publisher"]').should('have.value', 'New Publisher')
+      cy.then(() => {
+        expect(wrapper.vm.checkForChanges().updatePayload).to.deep.equal({ metadata: { title: 'Edited Title' } })
+      })
+    })
+  })
+
+  it('resets the form when a different item is loaded', () => {
+    cy.mount(BookDetailsEdit, mountOptions).then(({ wrapper }) => {
+      cy.get('input[placeholder="Title"]').clear().type('Edited Title')
+
+      cy.then(() => wrapper.setProps({ libraryItem: withMetadata({ ...libraryItem, id: 'li_2' }, { title: 'Other Title' }) }))
+
+      cy.get('input[placeholder="Title"]').should('have.value', 'Other Title')
+    })
+  })
+})
