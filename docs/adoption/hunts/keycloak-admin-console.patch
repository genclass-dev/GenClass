+
+test.describe("Realm settings saves on two tabs", () => {
+  const realmName = `two-tabs-realm-settings-${uuid()}`;
+  const displayName = "Display name saved on the General tab";
+
+  test.beforeAll(() =>
+    adminClient.createRealm(realmName, {
+      displayName: "Display name before the save",
+    }),
+  );
+  test.afterAll(() => adminClient.deleteRealm(realmName));
+
+  test("keeps the General tab's save when the Login tab saves before the realm is reloaded", async ({
+    page,
+  }) => {
+    await login(page);
+    await goToRealm(page, realmName);
+    await goToRealmSettings(page);
+
+    // Hold the reload of the realm that follows the first save until the Login tab has saved,
+    // as a slow network does.
+    let loginTabSaved!: () => void;
+    const saved = new Promise<void>((resolve) => (loginTabSaved = resolve));
+    await page.route(`**/admin/realms/${realmName}`, async (route) => {
+      if (route.request().method() === "PUT") loginTabSaved();
+      if (route.request().method() === "GET") await saved;
+      await route.continue();
+    });
+
+    await fillDisplayName(page, displayName);
+    await clickSaveRealm(page);
+    await assertNotificationMessage(page, "Realm successfully updated");
+    await goToLoginTab(page);
+    await toggleLoginSettingAndExpectSuccess(page, "user-reg-switch");
+
+    const realm = await adminClient.getRealm(realmName);
+    expect(realm?.displayName).toBe(displayName);
+    expect(realm?.registrationAllowed).toBe(true);
+  });
+});
