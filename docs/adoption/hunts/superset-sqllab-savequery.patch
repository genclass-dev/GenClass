 .../src/SqlLab/components/SaveQuery/index.tsx | 23 +++++++++++-----
 2 files changed, 44 insertions(+), 6 deletions(-)

diff --git a/superset-frontend/src/SqlLab/components/SaveQuery/SaveQuery.test.tsx b/superset-frontend/src/SqlLab/components/SaveQuery/SaveQuery.test.tsx
index d31449222b..bc8500e8ac 100644
--- a/superset-frontend/src/SqlLab/components/SaveQuery/SaveQuery.test.tsx
+++ b/superset-frontend/src/SqlLab/components/SaveQuery/SaveQuery.test.tsx
@@ -421,6 +421,33 @@ describe('SavedQuery', () => {
     expect(mockOnSave).toHaveBeenCalledTimes(1);
   });
 
+  test('saves once when save is clicked again while the save is in progress', async () => {
+    let resolveSave: () => void;
+    const savePromise = new Promise<void>(resolve => {
+      resolveSave = resolve;
+    });
+    const mockOnSave = jest.fn().mockImplementation(() => savePromise);
+
+    render(<SaveQuery {...mockedProps} onSave={mockOnSave} />, {
+      useRedux: true,
+      store: mockStore(mockState),
+    });
+
+    await userEvent.click(screen.getByRole('button', { name: /save/i }));
+    const modalSaveBtn = screen.getAllByRole('button', { name: /save/i })[1];
+    await userEvent.click(modalSaveBtn);
+    await userEvent.click(modalSaveBtn);
+
+    expect(mockOnSave).toHaveBeenCalledTimes(1);
+    expect(modalSaveBtn).toBeDisabled();
+    resolveSave!();
+    await waitFor(() => {
+      expect(
+        screen.queryByRole('heading', { name: /save query/i }),
+      ).not.toBeInTheDocument();
+    });
+  });
+
   test('handles save with a new tab that has no changes', async () => {
     const mockOnSave = jest.fn().mockResolvedValue(undefined);
 
