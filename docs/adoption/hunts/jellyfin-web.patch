From 2b1c0dcad3ff754e4ccdb7fb5354f3ebc0c1a8f5 Mon Sep 17 00:00:00 2001
From: Reference-fix <reference-fix@invalid.example>
Date: Tue, 3 Nov 2026 17:04:12 +0000
Subject: [PATCH 2/2] Ignore superseded responses in items container refresh

Changing a letter, the sort or a filter twice in a row sends two item
requests. When the older one arrives last, its items replaced the
newer results, so the grid did not match the selected letter or sort.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../emby-itemscontainer/emby-itemscontainer.js        | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/elements/emby-itemscontainer/emby-itemscontainer.js b/src/elements/emby-itemscontainer/emby-itemscontainer.js
index 3cac9dcb17..164168d4ec 100644
--- a/src/elements/emby-itemscontainer/emby-itemscontainer.js
+++ b/src/elements/emby-itemscontainer/emby-itemscontainer.js
@@ -13,6 +13,7 @@ import browser from 'scripts/browser';
 import inputManager from 'scripts/inputManager';
 import dom from 'utils/dom';
 import Events from 'utils/events';
+import { createRequestSequence } from 'utils/requestSequence';
 
 const ItemsContainerPrototype = Object.create(HTMLDivElement.prototype);
 
@@ -370,7 +371,15 @@ ItemsContainerPrototype.refreshItems = function () {
 
     this.needsRefresh = false;
 
-    return this.fetchData().then(onDataFetched.bind(this));
+    // A response that arrives after a newer refresh started must not replace the newer results
+    this.startRefresh ??= createRequestSequence();
+    const isLatestRefresh = this.startRefresh();
+
+    return this.fetchData().then(result => {
+        if (isLatestRefresh()) {
+            onDataFetched.call(this, result);
+        }
+    });
 };
 
 ItemsContainerPrototype.notifyRefreshNeeded = function (isInForeground) {
