From 55b2058e086037f6e1e59a38cc42870cade7ad72 Mon Sep 17 00:00:00 2001
From: Reference-fix <reference-fix@invalid.example>
Date: Tue, 3 Nov 2026 17:04:12 +0000
Subject: [PATCH 1/2] Add helper to track the latest of a sequence of requests

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/utils/requestSequence.test.ts | 60 +++++++++++++++++++++++++++++++
 src/utils/requestSequence.ts      | 15 ++++++++
 2 files changed, 75 insertions(+)
 create mode 100644 src/utils/requestSequence.test.ts
 create mode 100644 src/utils/requestSequence.ts

diff --git a/src/utils/requestSequence.test.ts b/src/utils/requestSequence.test.ts
new file mode 100644
index 0000000000..64c02a6a8c
--- /dev/null
+++ b/src/utils/requestSequence.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from 'vitest';
+
+import { createRequestSequence } from './requestSequence';
+
+/** A promise that the test resolves by hand, to deliver responses in any order. */
+function deferred<T>() {
+    let resolve!: (value: T) => void;
+    const promise = new Promise<T>(r => {
+        resolve = r;
+    });
+    return { promise, resolve };
+}
+
+describe('createRequestSequence', () => {
+    it('reports a single request as the latest', () => {
+        const start = createRequestSequence();
+        const isLatest = start();
+
+        expect(isLatest()).toBe(true);
+    });
+
+    it('reports an older request as superseded once a newer one starts', () => {
+        const start = createRequestSequence();
+        const first = start();
+        const second = start();
+
+        expect(first()).toBe(false);
+        expect(second()).toBe(true);
+    });
+
+    it('keeps the newer results when the older response arrives last', async () => {
+        const start = createRequestSequence();
+        const rendered: string[] = [];
+        const request = (response: Promise<string>) => {
+            const isLatest = start();
+            return response.then(result => {
+                if (isLatest()) rendered.push(result);
+            });
+        };
+
+        const b = deferred<string>();
+        const c = deferred<string>();
+        const done = Promise.all([ request(b.promise), request(c.promise) ]);
+
+        c.resolve('C');
+        b.resolve('B');
+        await done;
+
+        expect(rendered).toEqual([ 'C' ]);
+    });
+
+    it('keeps sequences independent of each other', () => {
+        const startA = createRequestSequence();
+        const startB = createRequestSequence();
+        const a = startA();
+        startB();
+
+        expect(a()).toBe(true);
+    });
+});
diff --git a/src/utils/requestSequence.ts b/src/utils/requestSequence.ts
new file mode 100644
index 0000000000..c97718416a
--- /dev/null
+++ b/src/utils/requestSequence.ts
@@ -0,0 +1,15 @@
+/**
+ * Creates a sequence of requests where only the latest one counts.
+ *
+ * Call the returned function when starting a request. It returns a check that tells,
+ * once the response arrives, whether the request is still the latest one, so a slow
+ * response to an older request does not replace the results of a newer request.
+ */
+export function createRequestSequence(): () => () => boolean {
+    let latest = 0;
+
+    return () => {
+        const id = ++latest;
+        return () => id === latest;
+    };
+}
-- 
