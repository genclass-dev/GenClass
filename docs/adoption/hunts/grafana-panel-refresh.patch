+import { waitFor } from '@testing-library/react';
+import { setBackendSrvWithPendingResponses } from 'test/helpers/backendSrvWithPendingResponses';
+
+import { configureStore } from 'app/store/configureStore';
+import { dispatch, getState } from 'app/store/store';
+
+import { changePage } from './actions';
+
+const usersPage = (page: number, login: string) => ({
+  users: [{ id: page, login, name: login, email: `${login}@example.com` }],
+  page,
+  perPage: 50,
+  totalCount: 150,
+});
+
+const flushPromises = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+describe('userListAdmin actions', () => {
+  it('keeps the users of the last requested page when an earlier page responds later', async () => {
+    const pending = setBackendSrvWithPendingResponses();
+    configureStore();
+
+    dispatch(changePage(2));
+    dispatch(changePage(3));
+    await waitFor(() => expect(pending).toHaveLength(2));
+    expect(pending[0].url).toContain('page=2');
+    expect(pending[1].url).toContain('page=3');
+
+    pending[1].respond(usersPage(3, 'third-page-user'));
+    await waitFor(() => expect(getState().userListAdmin.users[0]?.login).toBe('third-page-user'));
+
+    pending[0].respond(usersPage(2, 'second-page-user'));
+    await flushPromises();
+
+    const { users, page, isLoading } = getState().userListAdmin;
+    expect(users.map((user) => user.login)).toEqual(['third-page-user']);
+    expect(page).toBe(3);
+    expect(isLoading).toBe(false);
+  });
+
+  it('ignores a superseded response and stays loading until the latest one arrives', async () => {
+    const pending = setBackendSrvWithPendingResponses();
+    configureStore();
+
+    dispatch(changePage(2));
+    dispatch(changePage(3));
+    await waitFor(() => expect(pending).toHaveLength(2));
+
+    pending[0].respond(usersPage(2, 'second-page-user'));
+    await flushPromises();
+    expect(getState().userListAdmin.users).toEqual([]);
+    expect(getState().userListAdmin.isLoading).toBe(true);
+
+    pending[1].respond(usersPage(3, 'third-page-user'));
+    await waitFor(() => expect(getState().userListAdmin.isLoading).toBe(false));
+    expect(getState().userListAdmin.users.map((user) => user.login)).toEqual(['third-page-user']);
+  });
+});
