diff --git a/public/test/helpers/backendSrvWithPendingResponses.ts b/public/test/helpers/backendSrvWithPendingResponses.ts
new file mode 100644
index 00000000..377bc9dd
--- /dev/null
+++ b/public/test/helpers/backendSrvWithPendingResponses.ts
@@ -0,0 +1,52 @@
+import { Subject } from 'rxjs';
+
+import { type EventBusExtended } from '@grafana/data';
+import { setBackendSrv } from '@grafana/runtime';
+import { BackendSrv } from 'app/core/services/backend_srv';
+import { type ContextSrv } from 'app/core/services/context_srv';
+
+export interface PendingResponse {
+  url: string;
+  respond: (body: unknown) => void;
+}
+
+/**
+ * Installs a real BackendSrv whose network calls stay pending until the test responds to them,
+ * so a test controls the order in which responses arrive (including requestId cancellation).
+ * Returns the list of pending calls, in the order they were sent.
+ */
+export function setBackendSrvWithPendingResponses(): PendingResponse[] {
+  const pending: PendingResponse[] = [];
+  const fromFetch = jest.fn((input: string | Request) => {
+    const url = typeof input === 'string' ? input : input.url;
+    const response = new Subject<Response>();
+    pending.push({
+      url,
+      respond: (body: unknown) => {
+        response.next({
+          ok: true,
+          status: 200,
+          statusText: 'Ok',
+          headers: new Headers(),
+          redirected: false,
+          type: 'basic',
+          url,
+          text: () => Promise.resolve(JSON.stringify(body)),
+        } as unknown as Response);
+        response.complete();
+      },
+    });
+    return response.asObservable();
+  });
+
+  setBackendSrv(
+    new BackendSrv({
+      fromFetch,
+      appEvents: { emit: jest.fn(), publish: jest.fn() } as unknown as EventBusExtended,
+      contextSrv: { user: { orgId: 1, isSignedIn: true } } as unknown as ContextSrv,
+      logout: jest.fn(),
+    })
+  );
+
+  return pending;
+}
