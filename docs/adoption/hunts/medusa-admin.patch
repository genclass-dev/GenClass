@@ -0,0 +1,178 @@
+import React from "react"
+import { renderToString } from "react-dom/server"
+import { useForm } from "react-hook-form"
+import { afterEach, describe, expect, it, vi } from "vitest"
+
+import { ExchangeInboundSection } from "./exchange-inbound-section"
+
+const mocks = vi.hoisted(() => ({
+  addInboundItem: vi.fn(),
+  setIsOpen: vi.fn(),
+  buttonClicks: {} as Record<string, () => Promise<unknown>>,
+  onSelectionChange: undefined as undefined | ((ids: string[]) => void),
+}))
+
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({
+    t: (key: string) => key,
+  }),
+}))
+
+vi.mock("@medusajs/ui", () => ({
+  Alert: () => null,
+  Button: ({ children, onClick }: React.ComponentProps<"button">) => {
+    if (typeof children === "string" && onClick) {
+      mocks.buttonClicks[children] = onClick as () => Promise<unknown>
+    }
+    return <button>{children}</button>
+  },
+  Heading: ({ children }: { children: React.ReactNode }) => <h2>{children}</h2>,
+  Text: () => null,
+  toast: {
+    error: vi.fn(),
+  },
+}))
+
+vi.mock("../../../../../components/modals", () => {
+  const Passthrough = ({ children }: { children?: React.ReactNode }) => (
+    <>{children}</>
+  )
+
+  return {
+    RouteFocusModal: { Close: Passthrough },
+    StackedFocusModal: Object.assign(Passthrough, {
+      Trigger: Passthrough,
+      Content: Passthrough,
+      Header: () => null,
+      Footer: Passthrough,
+    }),
+    useStackedModal: () => ({ setIsOpen: mocks.setIsOpen }),
+  }
+})
+
+vi.mock("../../../../../components/common/form", () => ({
+  Form: { Field: () => null },
+}))
+
+vi.mock("../../../../../components/inputs/combobox", () => ({
+  Combobox: () => null,
+}))
+
+vi.mock("../../../../../hooks/api", () => ({
+  useShippingOptions: () => ({ shipping_options: [] }),
+  useStockLocations: () => ({ stock_locations: [] }),
+}))
+
+vi.mock("../../../../../hooks/api/exchanges", () => ({
+  useAddExchangeInboundItems: () => ({ mutateAsync: mocks.addInboundItem }),
+  useAddExchangeInboundShipping: () => ({ mutateAsync: vi.fn() }),
+  useDeleteExchangeInboundShipping: () => ({ mutateAsync: vi.fn() }),
+  useRemoveExchangeInboundItem: () => ({ mutateAsync: vi.fn() }),
+  useUpdateExchangeInboundItem: () => ({ mutateAsync: vi.fn() }),
+}))
+
+vi.mock("../../../../../hooks/api/returns", () => ({
+  useUpdateReturn: () => ({ mutateAsync: vi.fn() }),
+}))
+
+vi.mock("../../../../../lib/client", () => ({ sdk: {} }))
+
+vi.mock("../../../common/placeholders", () => ({
+  ReturnShippingPlaceholder: () => null,
+}))
+
+vi.mock(
+  "../../../order-create-claim/components/claim-create-form/item-placeholder",
+  () => ({ ItemPlaceholder: () => null })
+)
+
+vi.mock("../add-exchange-inbound-items-table", () => ({
+  AddExchangeInboundItemsTable: ({
+    onSelectionChange,
+  }: {
+    onSelectionChange: (ids: string[]) => void
+  }) => {
+    mocks.onSelectionChange = onSelectionChange
+    return null
+  },
+}))
+
+vi.mock("./exchange-inbound-item", () => ({
+  ExchangeInboundItem: () => null,
+}))
+
+const order = {
+  id: "order_1",
+  currency_code: "eur",
+  items: [{ id: "item_1" }, { id: "item_2" }],
+} as any
+
+const preview = { items: [], shipping_methods: [] } as any
+
+const Section = () => {
+  const form = useForm<any>({ defaultValues: { inbound_items: [] } })
+
+  return (
+    <ExchangeInboundSection
+      order={order}
+      preview={preview}
+      exchange={{ id: "exchange_1" } as any}
+      form={form}
+    />
+  )
+}
+
+const render = () => {
+  renderToString(<Section />)
+
+  return {
+    select: (ids: string[]) => mocks.onSelectionChange!(ids),
+    save: () => mocks.buttonClicks["actions.save"](),
+  }
+}
+
+describe("ExchangeInboundSection add items", () => {
+  afterEach(() => {
+    mocks.addInboundItem.mockReset()
+    mocks.setIsOpen.mockReset()
+    mocks.buttonClicks = {}
+    mocks.onSelectionChange = undefined
+  })
+
+  it("adds the selected items once when Save is pressed twice in a row", async () => {
+    let resolve: () => void = () => {}
+    mocks.addInboundItem.mockReturnValue(
+      new Promise<void>((r) => {
+        resolve = r
+      })
+    )
+
+    const { select, save } = render()
+    select(["item_1"])
+
+    const first = save()
+    const second = save()
+    resolve()
+    await Promise.all([first, second])
+
+    expect(mocks.addInboundItem).toHaveBeenCalledTimes(1)
+    expect(mocks.addInboundItem).toHaveBeenCalledWith(
+      { items: [{ id: "item_1", quantity: 1 }] },
+      expect.anything()
+    )
+  })
+
+  it("does not add the previous selection again when Save is pressed without a new selection", async () => {
+    mocks.addInboundItem.mockResolvedValue({})
+
+    const { select, save } = render()
+    select(["item_1"])
+    await save()
+
+    // the modal is opened again and saved without changing the selection
+    await render().save()
+
+    expect(mocks.addInboundItem).toHaveBeenCalledTimes(1)
+    expect(mocks.setIsOpen).toHaveBeenCalledTimes(2)
+  })
+})
