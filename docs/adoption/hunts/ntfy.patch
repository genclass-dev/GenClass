diff --git a/web/src/app/AccountApi.test.js b/web/src/app/AccountApi.test.js
index af3977cc..a5c7752b 100644
--- a/web/src/app/AccountApi.test.js
+++ b/web/src/app/AccountApi.test.js
@@ -212,4 +212,37 @@ describe("AccountApi.sync", () => {
     expect(prefs.setMinPriority).toHaveBeenCalledWith(3);
     expect(subscriptionManager.syncFromRemote).toHaveBeenCalledWith([{ topic: "t" }], [{ topic: "t" }]);
   });
+
+  it("removes the last local subscription when the account has none", async () => {
+    // The server omits an empty "subscriptions" list (omitempty)
+    fetchMock.mockResolvedValue(ok({ notification: { sound: "ding" } }));
+    await accountApi.sync();
+    expect(subscriptionManager.syncFromRemote).toHaveBeenCalledWith([], undefined);
+  });
+
+  it("skips an account that was fetched while the account was changed locally", async () => {
+    // Subscribing while a sync is in flight: the account it fetched may not have the new topic yet,
+    // and applying it would remove the topic again. The change's own sync event applies it instead.
+    let respond;
+    fetchMock
+      .mockImplementationOnce(
+        () =>
+          new Promise((resolve) => {
+            respond = resolve;
+          }),
+      )
+      .mockResolvedValueOnce(ok({ id: "sub_1" }));
+
+    const sync = accountApi.sync();
+    await accountApi.addSubscription("https://ntfy.sh", "new");
+    respond(ok({ notification: { min_priority: 1 }, subscriptions: [{ topic: "old" }] }));
+    await sync;
+
+    expect(prefs.setMinPriority).not.toHaveBeenCalled();
+    expect(subscriptionManager.syncFromRemote).not.toHaveBeenCalled();
+
+    fetchMock.mockResolvedValueOnce(ok({ subscriptions: [{ topic: "old" }, { topic: "new" }] }));
+    await accountApi.sync();
+    expect(subscriptionManager.syncFromRemote).toHaveBeenCalledWith([{ topic: "old" }, { topic: "new" }], undefined);
+  });
 });
