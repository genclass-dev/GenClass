From e0cf2842184448d62b36e6e58f9a87511c866282 Mon Sep 17 00:00:00 2001
From: GenClass hunt <hunt@localhost>
Date: Tue, 3 Nov 2026 16:53:39 +0000
Subject: [PATCH 1/2] fix(shopping): keep changes made while the sync queue is
 running

_replaySyncQueue removed each finished entry by the index it had when the
run started. Once an earlier entry was removed the indexes shifted, so a
later entry (for example unchecking an item right after checking it) was
removed without ever being sent, and the finished one stayed in the queue
and was sent again. A second run started while the first was in flight
also re-sent the entries still in flight.

Remove the finished entry itself, and let a run that starts while the
previous one is in flight wait for it (the previous run schedules the
queue again when its requests are done).
---
 vue3/src/stores/ShoppingStore.ts | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/vue3/src/stores/ShoppingStore.ts b/vue3/src/stores/ShoppingStore.ts
index e1535879a..f214fe44a 100644
--- a/vue3/src/stores/ShoppingStore.ts
+++ b/vue3/src/stores/ShoppingStore.ts
@@ -478,12 +478,17 @@ export const useShoppingStore = defineStore(_STORE_ID, () => {
      * @private
      */
     function _replaySyncQueue() {
+        if (syncQueueRunning.value) {
+            // requests of the previous run are still in flight, it runs the queue again once they are done
+            // so changes made in the meantime are sent after them, in the order they were made
+            return
+        }
         if (navigator.onLine || document.location.href.includes('localhost')) {
             let api = new ApiApi()
             let promises: Promise<void>[] = []
 
             let updatedEntries = new Map<number, ShoppingListEntry>()
-            itemCheckSyncQueue.value.forEach((entry, index) => {
+            itemCheckSyncQueue.value.forEach((entry) => {
                 entry['status'] = ((entry['status'] === 'waiting_failed_before') ? 'syncing_failed_before' : 'syncing')
                 syncQueueRunning.value = true
                 let p = api.apiShoppingListEntryBulkCreate({shoppingListEntryBulk: entry}, {}).then((r) => {
@@ -494,12 +499,12 @@ export const useShoppingStore = defineStore(_STORE_ID, () => {
                             updatedEntries.set(id, e)
                         }
                     })
-                    itemCheckSyncQueue.value.splice(index, 1)
+                    removeFromSyncQueue(entry)
                 }).catch((err) => {
                     if (err.name === "FetchError") {
                         entry['status'] = 'waiting_failed_before'
                     } else {
-                        itemCheckSyncQueue.value.splice(index, 1)
+                        removeFromSyncQueue(entry)
                         useMessageStore().addError(ErrorMessageType.UPDATE_ERROR, err)
                     }
                 })
@@ -521,6 +526,18 @@ export const useShoppingStore = defineStore(_STORE_ID, () => {
         }
     }
 
+    /**
+     * remove a finished entry from the sync queue
+     * the entry's position may have changed since the request was sent (entries before it finished first), so it is looked up again
+     * @param entry entry to remove
+     */
+    function removeFromSyncQueue(entry: IShoppingSyncQueueEntry) {
+        let index = itemCheckSyncQueue.value.indexOf(entry)
+        if (index >= 0) {
+            itemCheckSyncQueue.value.splice(index, 1)
+        }
+    }
+
     /**
      * manages running the replaySyncQueue function after the given timeout
      * calling this function might cancel a previously created timeout
-- 
