From e2547a94367e7686097d8efcbc081a59b64f8d29 Mon Sep 17 00:00:00 2001
From: GenClass hunt <hunt@localhost>
Date: Tue, 3 Nov 2026 17:08:37 +0000
Subject: [PATCH 2/2] fix(web): refetch a memo's reactions through its query

A reaction click fetched the memo with a raw getMemo call and wrote the reply
into the detail cache whenever it arrived. Adding two reactions quickly sent
two such fetches, and when the first one (asked before the second reaction
was saved) answered last, it wrote the older reactions over the newer ones:
the second reaction disappeared from the page although the server kept it,
until the next refetch.

The click now invalidates the memo's detail query instead. React Query
cancels an in-flight refetch of that query when it starts a newer one, so an
older copy of the reactions can no longer land after a newer one.
---
 .../components/MemoReactionListView/hooks.ts  |  6 +-
 web/tests/reaction-actions.test.tsx           | 65 +++++++++++++++++++
 2 files changed, 68 insertions(+), 3 deletions(-)
 create mode 100644 web/tests/reaction-actions.test.tsx

diff --git a/web/src/components/MemoReactionListView/hooks.ts b/web/src/components/MemoReactionListView/hooks.ts
index f544632f8..9404aca21 100644
--- a/web/src/components/MemoReactionListView/hooks.ts
+++ b/web/src/components/MemoReactionListView/hooks.ts
@@ -55,9 +55,9 @@ export const useReactionActions = ({ memo, onComplete }: UseReactionActionsOptio
           reaction: { reactionType },
         });
       }
-      // Refetch the memo to get updated reactions and invalidate cache
-      const updatedMemo = await memoServiceClient.getMemo({ name: memo.name });
-      queryClient.setQueryData(memoKeys.detail(memo.name), updatedMemo);
+      // Refetch the memo through its query: a newer refetch (another reaction, a live update) cancels this one, so an
+      // older copy of the reactions cannot land after a newer one.
+      await queryClient.invalidateQueries({ queryKey: memoKeys.detail(memo.name) });
       queryClient.invalidateQueries({ queryKey: memoKeys.lists() });
       // If this memo is a comment, refresh the parent's comments list so the comment's reactions update in the UI
       if (memo.parent) {
diff --git a/web/tests/reaction-actions.test.tsx b/web/tests/reaction-actions.test.tsx
new file mode 100644
index 000000000..c895cbf7a
--- /dev/null
+++ b/web/tests/reaction-actions.test.tsx
@@ -0,0 +1,65 @@
+import { create } from "@bufbuild/protobuf";
+import { QueryClient, QueryClientProvider, useQuery } from "@tanstack/react-query";
+import { act, renderHook, waitFor } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { useReactionActions } from "@/components/MemoReactionListView/hooks";
+import { memoDetailQueryOptions, memoKeys } from "@/hooks/useMemoQueries";
+import { type Memo, MemoSchema, ReactionSchema } from "@/types/proto/api/memo_service_pb";
+
+const api = vi.hoisted(() => ({ getMemo: vi.fn(), upsertMemoReaction: vi.fn(), deleteMemoReaction: vi.fn() }));
+vi.mock("@/connect", () => ({ memoServiceClient: api }));
+vi.mock("@/hooks/useCurrentUser", () => ({ default: () => ({ name: "users/me" }) }));
+vi.mock("@/contexts/MentionResolutionContext", () => ({ useResolvedUsersByNames: () => new Map() }));
+
+const setup = () => {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false, retryDelay: 0 }, mutations: { retry: false } } });
+  const wrapper = ({ children }: { children: ReactNode }) => <QueryClientProvider client={client}>{children}</QueryClientProvider>;
+  return { client, wrapper };
+};
+
+describe("useReactionActions", () => {
+  beforeEach(() => vi.resetAllMocks());
+
+  it("keeps the newer reactions when the first reaction's refetch answers last", async () => {
+    const { client, wrapper } = setup();
+    const name = "memos/x";
+    client.setQueryData(memoKeys.detail(name), create(MemoSchema, { name, reactions: [] }));
+    // The server's reactions, and the replies to getMemo, each holding the reactions saved when it was asked.
+    const saved: string[] = [];
+    const replies: Array<() => void> = [];
+    api.upsertMemoReaction.mockImplementation(async ({ reaction }: { reaction: { reactionType: string } }) => {
+      saved.push(reaction.reactionType);
+      return create(ReactionSchema, { reactionType: reaction.reactionType });
+    });
+    api.getMemo.mockImplementation(() => {
+      const reactions = saved.map((reactionType) => create(ReactionSchema, { reactionType, creator: "users/me" }));
+      return new Promise<Memo>((done) => replies.push(() => done(create(MemoSchema, { name, reactions }))));
+    });
+
+    // The detail page: the memo's query is observed, and the reaction picker acts on the memo it shows.
+    const { result } = renderHook(
+      () => {
+        const memo = useQuery(memoDetailQueryOptions(name)).data as Memo;
+        return { memo, actions: useReactionActions({ memo }) };
+      },
+      { wrapper },
+    );
+    act(() => {
+      void result.current.actions.handleReactionClick("👍");
+    });
+    await waitFor(() => expect(api.getMemo).toHaveBeenCalledTimes(1));
+    act(() => {
+      void result.current.actions.handleReactionClick("❤️");
+    });
+    await waitFor(() => expect(api.getMemo).toHaveBeenCalledTimes(2));
+
+    // The second refetch answers first, then the first one, which only knows about 👍.
+    await act(async () => replies[1]());
+    await act(async () => replies[0]());
+
+    await waitFor(() => expect(client.isFetching()).toBe(0));
+    expect(saved).toEqual(["👍", "❤️"]);
+    expect(result.current.memo.reactions.map((reaction) => reaction.reactionType)).toEqual(["👍", "❤️"]);
+  });
+});
